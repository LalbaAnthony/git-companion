{
  "name": "@lalba-anthony/git-companion",
  "version": "1.0.0",
  "description": "A companion tool for managing Git repositories efficiently.",
  "keywords": [
    "cli",
    "git"
  ],
  "type": "module",
  "bin": {
    "git-companion": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "Anthony Lalba",
  "homepage": "https://github.com/LalbaAnthony/git-companion#readme",
  "bugs": {
    "url": "https://github.com/LalbaAnthony/git-companion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LalbaAnthony/git-companion.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4"
  }
}
